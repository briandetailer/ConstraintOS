{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintos.local/schemas/render-specification.schema.json",
  "title": "ConstraintOS Render Specification Contract",
  "type": "object",
  "required": ["render_specification", "subject", "requirements", "validation"],
  "properties": {
    "render_specification": {
      "type": "object",
      "required": ["id", "title", "status", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^RSPEC-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "active", "deprecated"]},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "reference_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "severity", "validation_method"],
        "properties": {
          "id": {"type": "string", "pattern": "^REQ-[0-9]{4}$"},
          "statement": {"type": "string", "minLength": 1},
          "severity": {"enum": ["blocker", "major", "minor", "advisory"]},
          "validation_method": {"type": "string", "minLength": 1}
        }
      }
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string", "pattern": "^NEG-[0-9]{4}$"},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["gates"],
      "properties": {
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "required_pass"],
            "properties": {
              "id": {"type": "string", "pattern": "^GATE-[0-9]{4}$"},
              "name": {"type": "string", "minLength": 1},
              "required_pass": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
