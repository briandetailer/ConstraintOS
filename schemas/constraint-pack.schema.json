{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintos.local/schemas/constraint-pack.schema.json",
  "title": "Constraint Pack",
  "type": "object",
  "required": ["constraint_pack", "requirements", "validation"],
  "additionalProperties": false,
  "properties": {
    "constraint_pack": {
      "type": "object",
      "required": ["id", "title", "status", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^CPACK-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["draft", "active", "deprecated"]},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "severity", "validation_method"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^REQ-[0-9]{4}$"},
          "statement": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["blocker", "major", "minor", "advisory"]},
          "validation_method": {"type": "string", "minLength": 1}
        }
      }
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^NEG-[0-9]{4}$"},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["gates"],
      "additionalProperties": false,
      "properties": {
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "required_pass"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^GATE-[0-9]{4}$"},
              "name": {"type": "string", "minLength": 1},
              "required_pass": {"type": "boolean"},
              "description": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
