{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintos.local/schemas/volume-plan.schema.json",
  "title": "ConstraintOS Volume Plan",
  "type": "object",
  "required": ["volume_plan", "plates", "build_policy"],
  "properties": {
    "volume_plan": {
      "type": "object",
      "required": ["id", "title", "created", "status", "max_iterations_per_plate"],
      "properties": {
        "id": {"type": "string", "pattern": "^VOLUME-[0-9]{4}$"},
        "title": {"type": "string"},
        "created": {"type": "string"},
        "status": {"enum": ["draft", "running", "complete", "blocked", "failed"]},
        "max_iterations_per_plate": {"type": "integer", "minimum": 1}
      }
    },
    "plates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "specification_path", "sequence"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "specification_path": {"type": "string"},
          "sequence": {"type": "integer"}
        }
      }
    },
    "build_policy": {"type": "object"}
  }
}
