{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintos.local/schemas/lease-decision.schema.json",
  "title": "ConstraintOS Lease Decision",
  "type": "object",
  "required": ["lease_decision"],
  "properties": {
    "lease_decision": {
      "type": "object",
      "required": ["lease_id", "job_id", "worker_id", "decision", "reason", "created"],
      "properties": {
        "lease_id": {"type": "string"},
        "job_id": {"type": "string"},
        "worker_id": {"type": "string"},
        "decision": {"enum": ["keep", "release"]},
        "reason": {"type": "string"},
        "created": {"type": "string"}
      }
    }
  }
}
