{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintos.dev/schemas/runtime/v1/runtime-contract-registry.schema.json",
  "title": "ConstraintOS Runtime Contract Registry",
  "type": "object",
  "required": ["runtime_contract_registry", "contracts"],
  "additionalProperties": false,
  "properties": {
    "runtime_contract_registry": {
      "type": "object",
      "required": ["version", "contract_count"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "runtime-contracts/v1"
        },
        "contract_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "contract_type",
          "required_sections",
          "produced_by",
          "consumed_by",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "contract_type": {
            "type": "string",
            "enum": ["json_document", "artifact_json"]
          },
          "required_sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "produced_by": {
            "type": "string",
            "minLength": 1
          },
          "consumed_by": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
