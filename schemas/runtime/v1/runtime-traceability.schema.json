{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintos.dev/schemas/runtime/v1/runtime-traceability.schema.json",
  "title": "ConstraintOS Runtime Traceability",
  "type": "object",
  "required": ["runtime_traceability", "records"],
  "additionalProperties": false,
  "properties": {
    "runtime_traceability": {
      "type": "object",
      "required": ["runtime_id", "status", "success", "record_count"],
      "additionalProperties": false,
      "properties": {
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "success": {
          "type": "boolean"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "source_id", "runtime_id", "status", "parent_id", "metadata"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "plan_node",
              "scheduled_assignment",
              "unscheduled_node",
              "node_result",
              "artifact",
              "runtime_event"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "runtime_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "oneOf": [
              {"type": "string"},
              {"type": "null"}
            ]
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  }
}
