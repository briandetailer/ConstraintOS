{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintos.dev/schemas/runtime/v1/runtime-approval-decision.schema.json",
  "title": "ConstraintOS Runtime Approval Decision",
  "type": "object",
  "required": ["runtime_approval", "checks", "notes"],
  "additionalProperties": false,
  "properties": {
    "runtime_approval": {
      "type": "object",
      "required": [
        "runtime_id",
        "evidence_manifest_artifact_id",
        "decision",
        "decided_by",
        "decided_at",
        "approval_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_manifest_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": ["approved", "rejected", "needs_review", "waived"]
        },
        "decided_by": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "waived", "needs_review"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
