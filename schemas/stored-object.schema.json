{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintos.local/schemas/stored-object.schema.json",
  "title": "ConstraintOS Stored Object",
  "type": "object",
  "required": ["stored_object"],
  "properties": {
    "stored_object": {
      "type": "object",
      "required": ["id", "uri", "media_type", "size_bytes", "created"],
      "properties": {
        "id": {"type": "string"},
        "uri": {"type": "string"},
        "media_type": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "created": {"type": "string"}
      }
    }
  }
}
