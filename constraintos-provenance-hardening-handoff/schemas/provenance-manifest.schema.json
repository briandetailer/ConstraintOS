{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintos.local/schemas/provenance-manifest.schema.json",
  "title": "ConstraintOS Provenance Manifest",
  "type": "object",
  "required": [
    "provenance_manifest",
    "subject",
    "artifact",
    "validation",
    "traceability"
  ],
  "$defs": {
    "approval_status": {
      "type": "string",
      "enum": [
        "approved",
        "approved_with_warnings",
        "rejected"
      ]
    },
    "gate_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "passed",
        "failed",
        "missing_evidence",
        null
      ]
    },
    "node_status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "approved",
        "approved_with_warnings",
        "rejected",
        "required",
        "revision_required",
        "not_required"
      ]
    },
    "node_type": {
      "type": "string",
      "enum": [
        "validation_report",
        "failure_report",
        "remediation_plan",
        "revision_request",
        "approval_decision"
      ]
    },
    "evidence_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pass",
        "passed",
        "complete",
        "approved",
        "fail",
        "failed",
        "rejected",
        null
      ]
    }
  },
  "properties": {
    "provenance_manifest": {
      "type": "object",
      "required": [
        "id",
        "created",
        "status",
        "source",
        "constraint_packs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/approval_status"
        },
        "source": {
          "type": "string",
          "enum": [
            "validation_approval_pipeline"
          ]
        },
        "constraint_packs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "report_id",
        "status",
        "result_count"
      ],
      "properties": {
        "report_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "traceability": {
      "type": "object",
      "required": [
        "nodes",
        "gates"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "id",
              "status",
              "references"
            ],
            "properties": {
              "type": {
                "$ref": "#/$defs/node_type"
              },
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "$ref": "#/$defs/node_status"
              },
              "references": {
                "type": "object"
              }
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "gate_id",
              "gate_name",
              "status",
              "required_pass",
              "evidence_status",
              "issue_code"
            ],
            "properties": {
              "gate_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gate_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "$ref": "#/$defs/gate_status"
              },
              "required_pass": {
                "type": "boolean"
              },
              "evidence_status": {
                "$ref": "#/$defs/evidence_status"
              },
              "issue_code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
