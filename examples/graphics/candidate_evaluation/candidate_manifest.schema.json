{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constraintos.local/schemas/graphics/candidate_manifest.schema.json",
  "title": "ConstraintOS Graphics Candidate Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_manifest",
    "contract_binding",
    "candidate_reference",
    "candidate_source",
    "evaluation_boundary",
    "approval_expectation"
  ],
  "properties": {
    "candidate_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "domain",
        "status",
        "candidate_id",
        "submitted_at"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "const": "v1"},
        "domain": {"type": "string", "const": "graphics_validation"},
        "status": {"type": "string", "const": "static_fixture_only"},
        "candidate_id": {"type": "string", "minLength": 1},
        "submitted_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    },
    "contract_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_key",
        "contract_required",
        "allowed_contract_keys"
      ],
      "properties": {
        "contract_key": {
          "type": "string",
          "enum": [
            "perseverance",
            "wind_turbine_nacelle",
            "hydroelectric_dam_powerhouse",
            "supra_2jz_gte_twin_turbo"
          ]
        },
        "contract_required": {"type": "boolean", "const": true},
        "allowed_contract_keys": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 4,
          "uniqueItems": true
        },
        "source_contract_id": {"type": "string"}
      }
    },
    "candidate_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type",
        "reference",
        "reference_status",
        "media_type"
      ],
      "properties": {
        "reference_type": {
          "type": "string",
          "enum": [
            "local_path",
            "artifact_uri",
            "connector_file_reference",
            "object_store_uri"
          ]
        },
        "reference": {"type": "string", "minLength": 1},
        "reference_status": {"type": "string", "const": "reference_only_not_loaded"},
        "media_type": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "candidate_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_source_type",
        "generated_by_constraintos",
        "producer"
      ],
      "properties": {
        "candidate_source_type": {"type": "string", "const": "external"},
        "generated_by_constraintos": {"type": "boolean", "const": false},
        "producer": {"type": "string", "minLength": 1},
        "model_or_tool": {"type": "string"},
        "source_prompt_id": {"type": "string"},
        "source_prompt_text": {"type": "string"},
        "negative_prompt_text": {"type": "string"},
        "render_settings": {"type": "object"},
        "notes": {"type": "string"}
      }
    },
    "evaluation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_generation_allowed",
        "image_editing_allowed",
        "real_image_ingestion_allowed",
        "computer_vision_integration_allowed",
        "evaluation_status"
      ],
      "properties": {
        "image_generation_allowed": {"type": "boolean", "const": false},
        "image_editing_allowed": {"type": "boolean", "const": false},
        "real_image_ingestion_allowed": {"type": "boolean", "const": false},
        "computer_vision_integration_allowed": {"type": "boolean", "const": false},
        "evaluation_status": {"type": "string", "const": "not_evaluated"},
        "image_bytes_embedded": {"type": "boolean", "const": false}
      }
    },
    "approval_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_decisions",
        "initial_decision",
        "uncertainty_default"
      ],
      "properties": {
        "allowed_decisions": {
          "type": "array",
          "prefixItems": [
            {"type": "string", "const": "approved"},
            {"type": "string", "const": "needs_review"},
            {"type": "string", "const": "rejected"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "initial_decision": {"type": "string", "const": "needs_review"},
        "uncertainty_default": {"type": "string", "const": "needs_review"},
        "guardrail": {"type": "string"}
      }
    }
  }
}
