{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConstraintOS Graphics Candidate Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_report",
    "candidate_binding",
    "evaluation_boundary",
    "evidence_summary",
    "evidence_items",
    "recommendation"
  ],
  "properties": {
    "evaluation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "domain", "status", "report_mode", "generated_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "const": "v1"},
        "domain": {"type": "string", "const": "graphics_validation"},
        "status": {"type": "string", "const": "fixture_only"},
        "report_mode": {"type": "string", "const": "contract_shape_only_no_image_evaluation"},
        "generated_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    },
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_manifest_id", "candidate_id", "candidate_manifest_key", "contract_key", "candidate_reference_status"],
      "properties": {
        "candidate_manifest_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_manifest_key": {"type": "string", "minLength": 1},
        "contract_key": {"type": "string", "enum": ["perseverance", "wind_turbine_nacelle", "hydroelectric_dam_powerhouse", "supra_2jz_gte_twin_turbo"]},
        "candidate_reference_status": {"type": "string", "const": "reference_only_not_loaded"}
      }
    },
    "evaluation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_generation_ran", "image_editing_ran", "real_image_ingestion_ran", "computer_vision_integration_ran", "candidate_evaluation_ran", "approval_automation_ran"],
      "properties": {
        "image_generation_ran": {"type": "boolean", "const": false},
        "image_editing_ran": {"type": "boolean", "const": false},
        "real_image_ingestion_ran": {"type": "boolean", "const": false},
        "computer_vision_integration_ran": {"type": "boolean", "const": false},
        "candidate_evaluation_ran": {"type": "boolean", "const": false},
        "approval_automation_ran": {"type": "boolean", "const": false}
      }
    },
    "evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_items", "satisfied_count", "missing_count", "ambiguous_count", "contradicted_count", "not_observed_count", "overall_evidence_status"],
      "properties": {
        "total_items": {"type": "integer", "minimum": 1},
        "satisfied_count": {"type": "integer", "const": 0},
        "missing_count": {"type": "integer", "const": 0},
        "ambiguous_count": {"type": "integer", "const": 0},
        "contradicted_count": {"type": "integer", "const": 0},
        "not_observed_count": {"type": "integer", "minimum": 1},
        "overall_evidence_status": {"type": "string", "const": "not_observed"}
      }
    },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint_id", "constraint_group", "claim", "observed_status", "evidence_source", "confidence", "notes"],
        "properties": {
          "constraint_id": {"type": "string", "minLength": 1},
          "constraint_group": {"type": "string", "enum": ["subject_identity", "geometry", "component_location", "required_label", "forbidden_substitution", "rendering_requirement", "approval_guardrail"]},
          "claim": {"type": "string", "minLength": 1},
          "observed_status": {"type": "string", "const": "not_observed"},
          "evidence_source": {"type": "string", "const": "fixture_only_no_image_evidence"},
          "confidence": {"type": "number", "const": 0},
          "notes": {"type": "string"}
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_decisions", "recommended_decision", "reason", "uncertainty_default", "approval_allowed"],
      "properties": {
        "allowed_decisions": {
          "type": "array",
          "prefixItems": [
            {"type": "string", "const": "approved"},
            {"type": "string", "const": "needs_review"},
            {"type": "string", "const": "rejected"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "recommended_decision": {"type": "string", "const": "needs_review"},
        "reason": {"type": "string", "minLength": 1},
        "uncertainty_default": {"type": "string", "const": "needs_review"},
        "approval_allowed": {"type": "boolean", "const": false}
      }
    }
  }
}
